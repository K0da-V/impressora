# ===== Segurança =====
# Senha do painel (OBRIGATÓRIA em produção). Gere algo longo: openssl rand -hex 24
ADMIN_TOKEN=

# ===== IA (textos de produto, anúncios e atendimento) =====
GEMINI_API_KEY=
# "gemini-flash-latest" acompanha o modelo Flash mais recente; troque por um modelo fixo se preferir.
GEMINI_MODEL=gemini-flash-latest

# ===== Fornecedor: CJ Dropshipping (https://developers.cjdropshipping.com) =====
CJ_API_KEY=

# ===== Loja: escolha UMA =====
STORE_PROVIDER=auto            # auto | shopify | woocommerce | demo
STORE_PUBLIC_URL=              # ex.: https://minhaloja.com.br (usado nos links dos anúncios)
# Shopify (Admin API; escopos: write_products, read_products, read_orders, write_publications)
SHOPIFY_STORE_DOMAIN=          # minhaloja.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=        # segredo para validar webhooks (orders/paid) -> POST /webhooks/shopify
SHOPIFY_API_VERSION=2026-04
# WooCommerce (REST API v3)
WOO_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
WOO_WEBHOOK_SECRET=            # webhook de pedidos -> POST /webhooks/woocommerce

# ===== Anúncios: Meta Ads (Facebook/Instagram) =====
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=            # só números (sem "act_")
META_PAGE_ID=
META_PIXEL_ID=
META_API_VERSION=v23.0

# ===== Travas de segurança (valores seguros por padrão) =====
AUTOPILOT_ENABLED=false        # liga o ciclo automático
AUTOPILOT_INTERVAL_MIN=60
AUTO_PUBLISH_PRODUCTS=false    # false = produtos entram como RASCUNHO na loja
AUTO_ACTIVATE_ADS=false        # false = campanhas nascem PAUSADAS
AUTO_FULFILL_ORDERS=true       # pedido pago -> cria pedido no fornecedor
AUTO_PAY_SUPPLIER=false        # true = paga o pedido com saldo da CJ
MAX_NEW_PRODUCTS_PER_DAY=3
MAX_PUBLISHED_PRODUCTS=30
MAX_DAILY_AD_BUDGET_TOTAL_BRL=150
INITIAL_CAMPAIGN_BUDGET_BRL=30
MAX_CAMPAIGN_BUDGET_BRL=100

# ===== Regras de preço e escolha de produto =====
TARGET_MARGIN_PERCENT=45       # margem de contribuição desejada (após taxas, antes de anúncios)
MIN_MARGIN_PERCENT=35
MIN_PRICE_BRL=60
MAX_PRICE_BRL=400
MIN_STOCK=100
MAX_BREAK_EVEN_ROAS=3
PAYMENT_FEE_PERCENT=5
PAYMENT_FIXED_FEE_BRL=0.40
FX_USD_BRL=5.5                 # usado se a cotação online falhar
DEFAULT_SHIPPING_USD=6
TARGET_COUNTRY=BR
NICHE_KEYWORDS=neck massager,portable blender,led strip,pet hair remover
# BLOCKED_TERMS=...            # opcional: substitui a lista padrão de termos proibidos

# ===== Regras de anúncio (relativas ao ROAS de equilíbrio de cada produto) =====
MIN_SPEND_BEFORE_JUDGE_BRL=60
PAUSE_BELOW_BREAK_EVEN_FACTOR=0.8
SCALE_ABOVE_BREAK_EVEN_FACTOR=1.3
MIN_PURCHASES_TO_SCALE=3
SCALE_STEP_PERCENT=20

# ===== Atendimento =====
STORE_NAME=Minha Loja
SUPPORT_EMAIL=
# POLICY_DELIVERY=...
# POLICY_RETURNS=...

# ===== Servidor =====
PORT=3000
DATA_FILE=data/db.json
